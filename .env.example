# Restamp website environment variables
#
# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings -> Environment Variables.

# Production FastAPI backend base URL (no trailing slash).
# Required for production builds; falls back to https://api.restamp.in in client.ts if unset.
# Example: https://api.restamp.in
NEXT_PUBLIC_API_URL=
