# Restamp website environment variables
#
# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings -> Environment Variables.

# Production FastAPI backend base URL (no trailing slash).
# Required for production builds; falls back to the Render URL in client.ts if unset.
# Example: https://restamp-backend-h3x8.onrender.com
NEXT_PUBLIC_API_URL=
